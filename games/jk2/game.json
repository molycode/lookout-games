{
	"format": 1,
	"name": "Star Wars Jedi Knight II: Jedi Outcast",
	"protocol": "quake3",
	"text": {
		"encoding": "utf8OrWindows1252",
		"colourCodes": {
			"escape": "^",
			"codes": "printable",
			"palette": [ "#000000", "#ff0000", "#00ff00", "#ffff00", "#0000ff", "#00ffff", "#ff00ff", "#ffffff" ]
		}
	},
	"//protocolOptions": "Version 1.02 servers list under protocol 15 and 1.04 servers under 16; JK2MV joins both.",
	"protocolOptions": { "masterQuery": "15,16 empty full" },
	"//masters": "Raven's master closed; the community runs these.",
	"masters": [
		{ "host": "master.jkhub.org", "port": 28060 },
		{ "host": "master.jk2mv.org", "port": 28060 },
		{ "host": "master.jk2.daggolin.de", "port": 28060 }
	],
	"keys": {
		"hostname": "sv_hostname",
		"map": "mapname",
		"maxPlayers": "sv_maxclients",
		"password": "g_needpass",
		"mods": [ "gamename" ]
	},
	"modes": [
		{ "key": "g_gametype", "value": "0", "label": "Free for All" },
		{ "key": "g_gametype", "value": "1", "label": "Holocron FFA" },
		{ "key": "g_gametype", "value": "2", "label": "Jedi Master" },
		{ "key": "g_gametype", "value": "3", "label": "Duel" },
		{ "key": "g_gametype", "value": "4", "label": "Single Player" },
		{ "key": "g_gametype", "value": "5", "label": "Team FFA" },
		{ "key": "g_gametype", "value": "7", "label": "Capture the Flag" },
		{ "key": "g_gametype", "value": "8", "label": "Capture the Ysalamiri" }
	],
	"join": {
		"arguments": [ "+connect", "{address}" ],
		"passwordArguments": [ "+set", "password", "{password}", "+connect", "{address}" ],
		"password": {
			"maxLength": 63,
			"refusedCharacters": " \"$;+\\",
			"refusedSequences": [ "//", "/*" ]
		}
	}
}
