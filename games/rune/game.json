{
	"format": 1,
	"name": "Rune",
	"protocol": "gamespy1",
	"//queryPortOffset": "Servers answer queries on the port after the one players join.",
	"queryPortOffset": 1,
	"text": {
		"encoding": "utf8OrWindows1252"
	},
	"protocolOptions": { "masterGame": "rune" },
	"masters": [
		{ "host": "master.333networks.com", "port": 28900 },
		{ "host": "master.openspy.net", "port": 28900 }
	],
	"keys": {
		"hostname": "hostname",
		"map": "mapname",
		"numPlayers": "numplayers",
		"maxPlayers": "maxplayers",
		"password": "password",
		"mods": [ "gametype" ]
	},
	"modes": [
		{ "key": "gametype", "value": "RuneMultiPlayer", "label": "Deathmatch" },
		{ "key": "gametype", "value": "Teamgame", "label": "Team Deathmatch" },
		{ "key": "gametype", "value": "ArenaGameInfo", "label": "Arena" }
	],
	"join": {
		"//arguments": "The address is the game's URL; each option follows it after a '?'.",
		"arguments": [ "{address}" ],
		"passwordArguments": [ "{address}?password={password}" ],
		"password": {
			"maxLength": 1024,
			"//refusedCharacters": "'?' starts the next option, '#' a portal, and a space ends the URL.",
			"refusedCharacters": " ?#"
		}
	}
}
