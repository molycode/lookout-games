{
	"format": 1,
	"name": "Tremulous",
	"protocol": "quake3",
	"text": {
		"encoding": "utf8OrWindows1252",
		"//colourCodes": "GrangerHub's 62 colours, placed where a letter or digit finds them.",
		"colourCodes": {
			"escape": "^",
			"codes": "alphanumeric",
			"palette": [
				"#404040", "#ff0000", "#00ff00", "#ffff00", "#0000ff", "#00ffff", "#ff00ff", "#ffffff",
				"#808080", "#ffaf00", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ff3f34", "#228b22", "#ecbd2c", "#7b68ee", "#b2ffff", "#865040", "#dbd7d2",
				"#0f0f0f", "#65000b", "#7b785a", "#df9d5b", "#355e4f", "#35514f", "#8e593c", "#faf0be",
				"#100c08", "#ff033e", "#39ff14", "#faed27", "#120a8f", "#00ffef", "#8b008b", "#aaf0d1",
				"#d3d3d3", "#ff9999", "#90ee90", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#feab9a", "#98fb98", "#eee8aa", "#9bddff", "#afeeee", "#db7093", "#e8e5dc",
				"#3b3c36", "#ff6347", "#bfff00", "#fff700", "#4f86f7", "#40e0d0", "#fd5b78", "#eef3e5",
				"#9fa3a7", "#b7410e", "#6e8d71", "#ffd700", "#4682b4", "#7b9095", "#cd7f32", "#c0c0c0",
				"#a9a9a9", "#ff8c00", "#006400", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff",
				"#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff"
			],
			"hexCodes": [ "#RGB", "##RRGGBB" ]
		}
	},
	"//protocolOptions": "A server lists each protocol it speaks from its own port; 71 is Tremulous 1.3's own.",
	"protocolOptions": { "masterQuery": "71 empty full" },
	"masters": [
		{ "host": "master.tremulous.net", "port": 30700 }
	],
	"keys": {
		"hostname": "sv_hostname",
		"map": "mapname",
		"maxPlayers": "sv_maxclients",
		"password": "g_needpass"
	},
	"join": {
		"arguments": [ "+connect", "{address}" ],
		"passwordArguments": [ "+set", "password", "{password}", "+connect", "{address}" ],
		"password": {
			"maxLength": 63,
			"refusedCharacters": " \"$;+\\",
			"refusedSequences": [ "//", "/*" ]
		}
	}
}
