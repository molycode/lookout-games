{
	"format": 1,
	"name": "No One Lives Forever 2",
	"protocol": "gamespy1",
	"//queryPortOffset": "Servers answer queries on the port after the one players join.",
	"queryPortOffset": 1,
	"text": {
		"encoding": "utf8OrWindows1252"
	},
	"protocolOptions": { "masterGame": "nolf2" },
	"masters": [
		{ "host": "master.openspy.net", "port": 28900 }
	],
	"keys": {
		"hostname": "hostname",
		"map": "mapname",
		"numPlayers": "numplayers",
		"maxPlayers": "maxplayers",
		"password": "password",
		"mods": [ "gamever" ]
	},
	"modes": [
		{ "key": "gametype", "value": "Deathmatch", "label": "Deathmatch" },
		{ "key": "gametype", "value": "Cooperative", "label": "Cooperative" },
		{ "key": "gametype", "value": "Doomsday", "label": "Doomsday" }
	],
	"join": {
		"arguments": [ "-jointype", "internet", "-join", "{address}" ],
		"passwordArguments": [ "-jointype", "internet", "-join", "{address}", "-password", "{password}" ],
		"password": {
			"maxLength": 63,
			"refusedCharacters": " \""
		}
	}
}
