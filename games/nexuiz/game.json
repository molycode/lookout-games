{
	"format": 1,
	"name": "Nexuiz",
	"protocol": "quake3",
	"text": {
		"//encoding": "Nexuiz 2.5 predates DarkPlaces' UTF-8; its high bytes are the Quake font's glyphs.",
		"encoding": "ascii7",
		"colourCodes": {
			"escape": "^",
			"codes": "alphanumeric",
			"palette": [
				"#000000", "#ff0000", "#00ff00", "#ffff00", "#0d26ff", "#00ffff", "#ff00ff", "#ffffff",
				"#ffffff", "#808080", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff"
			],
			"hexCodes": [ "xRGB" ]
		}
	},
	"protocolOptions": { "masterQuery": "Nexuiz 3 empty full" },
	"masters": [
		{ "host": "dpmaster.deathmask.net", "port": 27950 },
		{ "host": "dpmaster.tchr.no", "port": 27950 }
	],
	"keys": {
		"hostname": "hostname",
		"map": "mapname",
		"maxPlayers": "sv_maxclients",
		"//password": "DarkPlaces has no join password, so no server sends this rule.",
		"password": "g_needpass",
		"mods": [ "modname" ]
	},
	"join": {
		"arguments": [ "+connect", "{address}" ],
		"passwordArguments": [ "+set", "password", "{password}", "+connect", "{address}" ],
		"password": {
			"maxLength": 63,
			"refusedCharacters": " \"$;+\\",
			"refusedSequences": [ "//", "/*" ]
		}
	}
}
