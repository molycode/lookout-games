{
	"format": 1,
	"name": "Star Trek Voyager: Elite Force",
	"protocol": "quake3",
	"text": {
		"encoding": "utf8OrWindows1252",
		"colourCodes": {
			"escape": "^",
			"codes": "alphanumeric",
			"palette": [ "#000000", "#ff0000", "#00ff00", "#ffff00", "#0000ff", "#00ffff", "#ff00ff", "#ffffff" ]
		}
	},
	"protocolOptions": { "masterQuery": "24 empty full", "masterEntries": "hex" },
	"//masters": "Raven's master closed; the community runs these.",
	"masters": [
		{ "host": "efmaster.tjps.eu", "port": 27953 },
		{ "host": "master.stef1.daggolin.de", "port": 27953 },
		{ "host": "master.stvef.org", "port": 27953 }
	],
	"keys": {
		"hostname": "sv_hostname",
		"map": "mapname",
		"maxPlayers": "sv_maxclients",
		"password": "g_needpass",
		"mods": [ "gamename" ]
	},
	"modes": [
		{ "key": "g_gametype", "value": "0", "label": "Free for All" },
		{ "key": "g_gametype", "value": "1", "label": "Tournament" },
		{ "key": "g_gametype", "value": "2", "label": "Single Player" },
		{ "key": "g_gametype", "value": "3", "label": "Team Holomatch" },
		{ "key": "g_gametype", "value": "4", "label": "Capture the Flag" }
	],
	"join": {
		"arguments": [ "+connect", "{address}" ],
		"passwordArguments": [ "+set", "password", "{password}", "+connect", "{address}" ],
		"password": {
			"maxLength": 63,
			"refusedCharacters": " \"$;+\\",
			"refusedSequences": [ "//", "/*" ]
		}
	}
}
